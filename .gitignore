# Documentation archives are local-only scratch/history.
docs/legacy/
docs/legacy/**

# -----------------------------------------------------------------------------
# Copie residue da merge/rebase o editor (mai committare — es. `.agent~HEAD`, `*.md~head`)
*~HEAD
*~BASE
*~LOCAL
*~REMOTE
*.orig
*.rej
*~head

# Backup locali (script conflitti / editor — mai committare)
*.bak
*.backup
*.backup.*
*.backup-*
*.backup_*
.cursor/
.devcontainer/
.vscode/
.windsurf/

# Local vector DB (agent tooling)
ruvector.db

# PHPStan output files
phpstan*

# Prevent docs/archive dirs
docs/archive

# Output strumenti AI (cache locali, mai in git)
graphify-out/
.headroom/

# Laraxot — quality tool configs forbidden in theme root (2026-09-15)
rector.php
phpinsights.php

# Laraxot — forbidden at module/theme root (rector.php, phpinsights.php, .cursor, .windsurf, .vscode)
/rector.php
/phpinsights.php
/.cursor
/.cursor/
/.windsurf
/.windsurf/
/.vscode
/.vscode/
.cursor~*
.windsurf~*

# Artefatti audit vietati (rule: tests-auditcoverage-forbidden)
tests/AuditCoverage/
audit-coverage/
.claude-audit/

/.github/skills/
.github/skills
/docs/graphify/
*.lock

# screenshot di comparazione visiva (artefatti locali)
docs/project/visual-comparison/
docs/visual-comparison/

# fila5-guard: mai nel repo di un modulo/tema
/node_modules/
/laravel/
/tests/coverage/
/tests/coverage.xml/
/tests/*coverage*.xml

# Niente cartelle di backup/archivio in docs: lo storico e' git (ADR Xot 0041)
docs/**/archivio/
docs/**/archive/
docs/**/_archive/
docs/**/archived/
docs/**/*backup*/
docs/**/wiki-archive/
docs/**/historical/

# No docs archive folders — restore via Git only (Xot ADR 0041)
docs/archivio/
docs/**/archivio/
docs/archive/
docs/**/archive/
docs/_archive/
docs/**/_archive/
docs/archived/
docs/**/archived/
docs/historical/
docs/**/historical/
docs/backup/
docs/**/backup/
docs/backups/
docs/**/backups/
.docs-archive/
